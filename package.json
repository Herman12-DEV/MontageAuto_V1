{
  "name": "montageauto-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "en-ligne": "node scripts/en-ligne.mjs",
    "dev": "vite --host ::",
    "build": "tsc --noEmit && vite build && node scripts/netlify-postbuild.mjs",
    "preview": "vite preview --host ::",
    "typecheck": "tsc --noEmit",
    "netlify:deploy": "npm run build && npx --yes netlify-cli@27 deploy --prod --dir=dist"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "firebase": "^13.0.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.4"
  }
}
