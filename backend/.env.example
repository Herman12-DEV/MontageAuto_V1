# Copiez ce fichier en .env et adaptez les valeurs.

# development | production
APP_ENV=development
BRAND_NAME=AutoCut
# Obligatoire en production (chaîne aléatoire longue). En dev, une clé est générée dans storage/.
SECRET_KEY=

# URL publique du site : utilisée dans les liens des e-mails et les retours Stripe.
# En dev avec Vite : http://localhost:5173 — en prod : https://votre-domaine.com
PUBLIC_URL=http://localhost:5173

# SQLite par défaut (dev). Production : postgresql://user:motdepasse@localhost:5432/autocut
# DATABASE_URL=
# STORAGE_DIR=./storage
# MUSIC_DIR=./music

# Moteur
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# tiny | base | small | medium — small = meilleur compromis précision/vitesse sur CPU
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
X264_PRESET=veryfast
X264_CRF=20

# File d'attente : true = un worker tourne dans le processus de l'API (pratique en dev).
# En production, mettre false et lancer des workers séparés : python -m app.worker
EMBEDDED_WORKER=true

# Limites
MAX_UPLOAD_MB=500
RETENTION_DAYS=30

# E-mails (vide = messages écrits dans storage/outbox et affichés dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=AutoCut <no-reply@votre-domaine.com>

# Paiement Stripe (mode test : clés sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCE=
# Sans Stripe configuré : true active les offres sans paiement (DÉMO / DEV UNIQUEMENT)
DEV_FAKE_PAYMENTS=true

# Connexion Google : identifiant client OAuth « Application Web »
# (console.cloud.google.com → API et services → Identifiants). Vide = bouton Google inactif.
GOOGLE_CLIENT_ID=

# Firebase : vérification des jetons de connexion et stockage des vidéos importées.
FIREBASE_PROJECT_ID=autocut-eb855
FIREBASE_STORAGE_BUCKET=autocut-eb855.firebasestorage.app
# Développement avec les émulateurs Firebase uniquement (laisser vide sinon) :
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
