# /etc/systemd/system/autocut-api.service — API + site (frontend compilé dans dist/)
[Unit]
Description=AutoCut API
After=network.target postgresql.service

[Service]
User=autocut
WorkingDirectory=/opt/autocut/backend
EnvironmentFile=/opt/autocut/backend/.env
ExecStart=/opt/autocut/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
